            <string>GhostKitVersion</string>
            <key>Value</key>
            <string>1.0.16</string>
            <key>DefaultValue</key>
            <string>1.0.16</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>作者</string>
            <key>Value</key>
            <string>GhostKit Project</string>
            <key>DefaultValue</key>
            <string>GhostKit Project</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>许可证</string>
            <key>Value</key>
            <string>MIT</string>
            <key>DefaultValue</key>
            <string>MIT</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>适用越狱</string>
            <key>Value</key>
            <string>Rootless / TrollStore</string>
            <key>DefaultValue</key>
            <string>Rootless / TrollStore</string>
        </dict>
    </array>
</dict>
</plist>
