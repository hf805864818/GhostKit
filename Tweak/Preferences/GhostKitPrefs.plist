            <string>🔄 注销 (Respring)</string>
            <key>Key</key>
            <string>GhostKitRespringButton</string>
            <key>Action</key>
            <string>respringButtonTapped</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSButtonSpecifier</string>
            <key>Title</key>
            <string>🔄 软重启 (ldrestart)</string>
            <key>Key</key>
            <string>GhostKitLdrestartButton</string>
            <key>Action</key>
            <string>ldrestartButtonTapped</string>
        </dict>

        <!-- About -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>关于</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>版本</string>
